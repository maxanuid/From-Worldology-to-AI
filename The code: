# ═══════════════════════════════════════════════════════════════════
#  EXPRESSION PARSER
#  Supports: + - * / ^ and ∞ notation.  Normalizes ÷ × symbols.
# ═══════════════════════════════════════════════════════════════════

def parse_expression(expr: str):
    e = expr.strip().replace('÷', '/').replace('×', '*').replace(' ', '')
    m = re.match(
        r'^(-?\d+\.?\d*|inf)([\+\-\*/\^])(-?\d+\.?\d*|inf)$',
        e, re.IGNORECASE
    )
    if not m:
        return None
    def val(s):
        return inf if s.lower() == 'inf' else sp.sympify(s)
    return val(m.group(1)), m.group(2), val(m.group(3))


def fmt(v) -> str:
    return str(v).replace('oo', '∞').replace('nan', 'NaN')


