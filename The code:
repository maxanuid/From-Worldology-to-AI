    def decide(self, text: str, domain: str, depth: int) -> dict:
        idx = int(hashlib.sha256(text.encode()).hexdigest(), 16) % 7
        return {
            'sin':      SEVEN_SINS[idx],
            'virtue':   SEVEN_VIRTUES[idx],
            'rational': SEVEN_RATIONAL[idx],
            'context':  self.META_CONTEXT.get(domain, self.META_CONTEXT['worldology']),
            'sin_advice':      self.SIN_META[SEVEN_SINS[idx]],
            'virtue_advice':   self.VIRTUE_META[SEVEN_VIRTUES[idx]],
            'rational_advice': self.RATIONAL_STRATEGY[SEVEN_RATIONAL[idx]],
            'domain': domain,
            'depth':  depth,
        }

